@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 0
skinparam shadowing false

skinparam node {
    borderColor #D9480F
    backgroundColor #FFE8CC
    fontColor #000000
    fontStyle bold
}
skinparam database {
    borderColor #D9480F
    backgroundColor #FFE8CC
    fontColor #000000
    fontStyle bold
}
skinparam component {
    borderColor #D9480F
    backgroundColor #FFE8CC
    fontColor #000000
    fontStyle bold
}
skinparam arrow {
    color #D9480F
    fontColor #000000
}

title **Діаграма розгортання торгової вебплатформи**

node "Комп'ютер" as PC
node "Смартфон" as Mobile
node "Сервер" as Server
database "База даних" as DB {
    [СУБД]
}
node "Біржа" as Exchange

PC -[hidden]down- Mobile

PC -right-> Server : HTTPS
Mobile -right-> Server : HTTPS
Server -right-> DB : TCP / SSL
Server -down-> Exchange : REST API
@enduml
