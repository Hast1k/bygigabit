@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 10
skinparam shadowing false
skinparam linetype ortho

skinparam actor {
    borderColor #0284C7
    backgroundColor #E0F2FE
    fontColor #0F172A
}
skinparam usecase {
    borderColor #0284C7
    backgroundColor #BAE6FD
    fontColor #0369A1
}
skinparam note {
    borderColor #64748B
    backgroundColor #FFFFFF
    fontColor #334155
}
skinparam arrow {
    color #0284C7
    fontColor #0F172A
}

left to right direction

actor "Гість" as Guest
actor "Авторизований\nтрейдер" as Trader
actor "Адміністратор" as Admin

actor "SMTP Gateway" as SMTP <<service>>
actor "Bybit V5 API" as Bybit <<service>>

Trader -up-|> Guest
Admin -up-|> Trader

rectangle "Вебплатформа ByGigaBit" {
    usecase "Реєстрація та вхід" as UC_Auth
    usecase "Двоетапна перевірка (TOTP 2FA)" as UC_2FA
    usecase "Відновлення доступу через Email" as UC_Reset
    usecase "Керування особистим профілем" as UC_Profile

    usecase "Перегляд свічкового графіка" as UC_Chart
    usecase "Відкриття маржинальної позиції" as UC_Order
    usecase "Введення параметрів (плече, маржа)" as UC_Params
    usecase "Виставлення лімітного ордера" as UC_Limit
    usecase "Закриття позиції та фіксація PnL" as UC_Close
    usecase "Автоматична ліквідація (Margin Call)" as UC_Liq

    usecase "Симулятор сценаріїв (25 свічок)" as UC_Train
    usecase "Стрес-тестування (Chaos Mode)" as UC_Chaos
    usecase "Аналітика AI Quant Radar" as UC_AI
    usecase "Журнал угод та крива капіталу" as UC_Journal

    usecase "Перегляд реєстру користувачів" as UC_AdminUsers
    usecase "Блокування / розблокування акаунта" as UC_AdminBlock
    usecase "Моніторинг системної статистики" as UC_AdminStats

    note as N_CRUD
      **CRUD операції платформи:**
      **C (Create)** - відкриття ордерів (Market/Limit)
      **R (Read)** - котирування Bybit, історія, графік
      **U (Update)** - баланс трейдера, статус 2FA, пароль
      **D (Delete)** - скасування активних лімітних заявок
    end note
}

Guest --> UC_Auth

Trader --> UC_Profile
Trader --> UC_Chart
Trader --> UC_Order
Trader --> UC_Close
Trader --> UC_Train
Trader --> UC_Chaos
Trader --> UC_AI
Trader --> UC_Journal

Admin --> UC_AdminUsers
Admin --> UC_AdminBlock
Admin --> UC_AdminStats

UC_Auth <.. UC_2FA : <<extend>>
UC_Auth <.. UC_Reset : <<extend>>
UC_Order ..> UC_Params : <<include>>
UC_Order <.. UC_Limit : <<extend>>
UC_Order ..> UC_Liq : <<include>>

UC_Chart <-- Bybit
UC_Order <-- Bybit
UC_2FA --> SMTP
UC_Reset --> SMTP
@enduml