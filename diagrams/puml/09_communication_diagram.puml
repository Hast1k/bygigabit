@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam shadowing false

skinparam rectangle {
    borderColor #B85450
    backgroundColor #F8CECC
    fontColor #111111
    fontStyle bold
}
skinparam database {
    borderColor #B85450
    backgroundColor #F8CECC
    fontColor #111111
    fontStyle bold
}
skinparam actor {
    borderColor #B85450
    backgroundColor #F8CECC
    fontColor #111111
}
skinparam arrow {
    color #B85450
    fontColor #1E293B
}

actor ":Користувач" as User
rectangle ":Інтерфейс" as UI
rectangle ":Угоди" as Orders
rectangle ":Позиція" as Position
rectangle ":Котирування" as Market
database ":База даних" as DB

User -- UI : 1: Отримати дані про актив >\n2: Інформація про актив <\n3: Створити ордер >\n14: Позицію відкрито <
UI -- Orders : 4: Параметри ордера >\n13: Створена позиція <
Orders -- DB : 5: Перевірити баланс >\n6: Результат перевірки <\n11: Зберегти позицію >\n12: Результат транзакції <
Orders -- Market : 7: Запит ціни >\n8: Ринкова ціна <
Orders -- Position : 9: Розрахувати ризики >\n10: Сформована позиція <
DB -- Position : 11a: Запис даних >
@enduml
