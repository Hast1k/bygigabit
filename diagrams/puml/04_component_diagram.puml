@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam roundCorner 0
skinparam shadowing false

skinparam component {
    borderColor #333333
    backgroundColor #FFF2CC
    fontColor #111111
    fontStyle bold
}
skinparam interface {
    borderColor #333333
    backgroundColor #FFFFFF
    fontColor #111111
    fontStyle bold
}
skinparam arrow {
    color #333333
}

title **Діаграма компонентів торгової вебплатформи**

[Клієнт] as Client

interface "REST API" as API_Int
interface "SQL" as SQL_Int

Client -right-> API_Int

' Колонка 1: Основні функціональні модулі
[Авторизація] as C_Auth
[Користувачі] as C_Users
[Угоди] as C_Order
[Сценарії] as C_Sim
[Котирування] as C_Market

API_Int --> C_Auth
API_Int --> C_Users
API_Int --> C_Order
API_Int --> C_Sim
API_Int --> C_Market

' Колонка 2: Обробка бізнес-логіки
[Безпека та 2FA] as M_Auth
[Баланс і гаманець] as M_Users
[Розрахунок ризиків] as M_Order
[Аналітика] as M_Sim
[Шлюз біржі] as M_Market

C_Auth ..> M_Auth
C_Users ..> M_Users
C_Order ..> M_Order
C_Sim ..> M_Sim
C_Market ..> M_Market

' Колонка 3: Компоненти збереження даних
[Сесії] as R_Auth
[Профілі] as R_Users
[Позиції] as R_Order
[Історія] as R_Hist
[Кеш ринку] as R_Market

M_Auth ..> R_Auth
M_Users ..> R_Users
M_Order ..> R_Order
M_Sim ..> R_Hist
M_Market ..> R_Market

R_Auth --> SQL_Int
R_Users --> SQL_Int
R_Order --> SQL_Int
R_Hist --> SQL_Int
R_Market --> SQL_Int

[СУБД] as DB
SQL_Int --> DB

' Зовнішні сервіси
[Поштовий сервіс] as S_Mail
[Зовнішня біржа] as S_Exchange

M_Auth ..> S_Mail
M_Market ..> S_Exchange
@enduml
